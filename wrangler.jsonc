{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter3-canary-frontend",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "BACKEND_WORKER",
      "service": "starter3-canary-backend"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://iotldbnwtnzpwpyhwgmo.supabase.co",
    "NEXT_PUBLIC_SUPABASE_URL": "https://iotldbnwtnzpwpyhwgmo.supabase.co",
    "BACKEND_URL": "https://starter3-canary-backend.luke-9ffworkersdev.workers.dev"
  }
}
